{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "route", "tls", "persistence", "bootstrap", "oidc", "resources", "monitoring"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}}
      }
    },
    "route": {"type": "object", "required": ["host"]},
    "tls": {"type": "object", "required": ["servingCertSecretName"]},
    "persistence": {"type": "object", "required": ["existingClaim", "storageClass", "size"]},
    "bootstrap": {"type": "object", "required": ["email", "existingSecret", "passwordKey"]},
    "resources": {"type": "object"},
    "oidc": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "enableInternalLogin": {"type": "boolean"},
        "autoCreateUser": {"type": "boolean"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"required": ["tenantId", "clientId", "existingSecret", "clientSecretKey", "autoCreateUser", "enableInternalLogin"]}
    },
    "monitoring": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}},
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {
        "required": ["exporter", "serviceMonitor"],
        "properties": {
          "exporter": {
            "type": "object",
            "required": ["image", "resources"],
            "properties": {
              "image": {
                "type": "object",
                "required": ["repository", "tag", "pullPolicy"],
                "properties": {"tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}}}
              }
            }
          },
          "serviceMonitor": {
            "type": "object",
            "required": ["enabled", "interval", "scrapeTimeout"],
            "properties": {"enabled": {"type": "boolean"}}
          }
        }
      }
    }
  }
}
